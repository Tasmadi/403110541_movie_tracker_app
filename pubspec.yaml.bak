name: movie_tracker_app
description: "A new Flutter project."
publish_to: 'none'
version: 0.1.0

environment:
  sdk: '>=3.4.0 <4.0.0'

dependencies:
  cached_network_image: ^3.4.1
  cryptography: ^2.9.0
  flutter:
    sdk: flutter
  flutter_secure_storage: 9.2.4
  http: ^1.6.0
  image_picker: 1.1.0
  path: ^1.9.0
  path_provider: 2.1.4
  sqflite: ^2.3.3+1
  google_fonts: 4.0.5

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^3.0.0
  flutter_launcher_icons: ^0.14.1
  flutter_native_splash: ^2.4.1

flutter:
  uses-material-design: true

flutter_launcher_icons:
  android: true
  ios: true
  image_path: assets/icons/tv_time_icon.png

  adaptive_icon_foreground: assets/icons/tv_time_foreground.png
  adaptive_icon_background: "#0D0D12"

flutter_native_splash:
  color: "#0D0D12"
  image: assets/icons/tv_time_splash.png

  android_12:
    color: "#0D0D12"
    image: assets/icons/tv_time_splash.png